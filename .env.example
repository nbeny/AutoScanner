# === Server ===
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# === Auth ===
JWT_SECRET=replace-me-with-64-random-hex-chars
# 15 min
ACCESS_TOKEN_TTL_SECONDS=900
# 30 days
REFRESH_TOKEN_TTL_SECONDS=2592000
MASTER_ENCRYPTION_KEY=replace-me-base64-32-bytes

# === Postgres ===
DATABASE_URL=postgresql://autoscanner:dev@localhost:5432/autoscanner

# === MongoDB === (prepared, not yet consumed by any worker)
# The container is gated behind the `mongo` compose profile and is NOT started
# by `pnpm dev:up` (see docker/docker-compose.dev.yml). This URL stays set so
# env validation passes; `pnpm dev:up:mongo` starts the container when needed.
MONGODB_URL=mongodb://localhost:27017/autoscanner

# === Redis ===
REDIS_URL=redis://localhost:6379

# === MinIO / S3 ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=autoscanner
S3_SECRET_KEY=devpassword

# === Logging ===
LOG_LEVEL=info
LOG_PRETTY=true

# === Operator seed ===
OPERATOR_EMAIL=admin@autoscanner.local
OPERATOR_PASSWORD=changeme

# === Telemetry ===
PROMETHEUS_PORT=9091

# === AutoHunt AI orchestrator (Claude via subscription) ===
# The ai-orchestrator-worker asks Claude Sonnet which scanner to run next. It
# invokes the Claude Code CLI (`claude -p`) and forces your SUBSCRIPTION session
# by scrubbing API-key env vars — no ANTHROPIC_API_KEY needed. Same pattern as
# ../BotTrading. `stub` transport is for offline tests only.
ANTHROPIC_TRANSPORT=cli
ANTHROPIC_CLI_PATH=claude
ANTHROPIC_SONNET_MODEL=sonnet
ANTHROPIC_CLI_TIMEOUT_MS=120000
ANTHROPIC_CLI_CONCURRENCY=4
# Host paths to your authenticated Claude CLI credentials, mounted read-only into
# the containerized worker (docker/ai/docker-compose.ai.yml). On the host, run
# `claude` once to log in; these point at the resulting credential files.
CLAUDE_DIR=C:\Users\nbeny\.claude
CLAUDE_CONFIG=C:\Users\nbeny\.claude.json

# === Notifications ===
# SMTP_URL=smtp://user:pass@localhost:1025
NOTIFICATIONS_FROM=autoscanner@localhost

# === Webhooks ===
# WEBHOOK_GENERIC_TOKEN=
# WEBHOOK_ZAP_TOKEN=
# WEBHOOK_BURP_TOKEN=

# === OAST (out-of-band scanning for web-dast blind detection) ===
# Self-hosted interactsh server (see docker/oast/README.md). When OAST_SERVER_URL
# is unset, web-dast runs in-band only (no callback leaves your network) unless
# OAST_ALLOW_PUBLIC=true, which opts into ProjectDiscovery's public oast.pro.
# OAST_SERVER_URL=https://oast.example.com
# OAST_TOKEN=
OAST_ALLOW_PUBLIC=false
# Used only by docker/oast/docker-compose.oast.yml:
# OAST_DOMAIN=oast.example.com

# === Authenticated scanning (SP4) ===
# Session injected into web scanners (katana crawl, web-dast fuzzing, sqli-scan)
# so they test behind login. Global per worker in v1; per-engagement auth is a
# follow-up. SCAN_AUTH_HEADERS is a JSON object of header name -> value.
# SCAN_AUTH_COOKIE=session=abc; csrf=def
# SCAN_AUTH_HEADERS={"Authorization":"Bearer xyz"}

# === Messaging (SP0 Kafka migration) ===
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=autoscanner
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
