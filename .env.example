# === Server ===
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# === Auth ===
JWT_SECRET=replace-me-with-64-random-hex-chars
# 15 min
ACCESS_TOKEN_TTL_SECONDS=900
# 30 days
REFRESH_TOKEN_TTL_SECONDS=2592000
MASTER_ENCRYPTION_KEY=replace-me-base64-32-bytes

# === Postgres ===
DATABASE_URL=postgresql://autoscanner:dev@localhost:5432/autoscanner

# === MongoDB === (unused in Phase 0, prepared)
MONGODB_URL=mongodb://localhost:27017/autoscanner

# === Redis ===
REDIS_URL=redis://localhost:6379

# === MinIO / S3 ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=autoscanner
S3_SECRET_KEY=devpassword

# === Logging ===
LOG_LEVEL=info
LOG_PRETTY=true

# === Operator seed ===
OPERATOR_EMAIL=admin@autoscanner.local
OPERATOR_PASSWORD=changeme

# === Telemetry ===
PROMETHEUS_PORT=9091

# === Notifications ===
# SMTP_URL=smtp://user:pass@localhost:1025
NOTIFICATIONS_FROM=autoscanner@localhost

# === Webhooks ===
# WEBHOOK_GENERIC_TOKEN=
# WEBHOOK_ZAP_TOKEN=
# WEBHOOK_BURP_TOKEN=
