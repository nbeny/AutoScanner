# Frontend: build the Vite/React SPA, serve the static bundle with nginx.
# VITE_API_URL is baked at build time (the SPA runs in the browser, so it must
# point at the API's HOST-published address, e.g. http://localhost:4000).
FROM node:22-slim AS build
WORKDIR /app
ARG VITE_API_URL=http://localhost:4000
ENV VITE_API_URL=${VITE_API_URL}
COPY . .
RUN corepack enable \
  && pnpm install --frozen-lockfile \
  && pnpm nx build frontend

FROM nginx:alpine
COPY --from=build /app/dist/apps/frontend /usr/share/nginx/html
# SPA history fallback so client-side routes (/hunt, /chains, …) resolve.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' \
  > /etc/nginx/conf.d/default.conf
