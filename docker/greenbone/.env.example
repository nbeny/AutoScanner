# =============================================================================
# Greenbone scanner stack — environment variables
# Copy this file to .env (same directory) before running docker compose.
# =============================================================================

# -----------------------------------------------------------------------------
# API key for openvasd HTTP API authentication.
# IMPORTANT: This value must also be registered as the AutoScanner operator
# credential with key name OPENVAS (env var OPENVAS_API_KEY or equivalent)
# so that the AutoScanner scan-worker can inject it into requests to openvasd.
# Change this from the default before any production or shared deployment.
# -----------------------------------------------------------------------------
OPENVASD_API_KEY=changeme

# -----------------------------------------------------------------------------
# Image tag pins — all Greenbone Community Container images below.
# Verify current tags against: https://github.com/greenbone/greenbone-community-container/releases
# Using 'latest' is convenient but not reproducible; pin to a release tag
# (e.g. 22.4.1) once you have confirmed the stack is working.
# -----------------------------------------------------------------------------
OPENVASD_TAG=latest
MQTT_BROKER_TAG=latest
REDIS_SERVER_TAG=latest
VT_TAG=latest
NOTUS_DATA_TAG=latest
NOTUS_SCANNER_TAG=latest
SCAP_DATA_TAG=latest

# -----------------------------------------------------------------------------
# Operational tuning
# -----------------------------------------------------------------------------
# Log level for openvasd: trace | debug | info | warn | error
OPENVASD_LOG_LEVEL=info

# Set to 'true' only in offline/air-gapped environments where notus hash
# verification cannot reach the Greenbone feed signing key.
NOTUS_DISABLE_HASHSUM_VERIFICATION=false
